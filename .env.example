SECRET_KEY=change-this-in-production-django-secret-key-super-secure
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Database (PostgreSQL default for Docker, falls back to SQLite if not provided)
DATABASE_URL=postgres://postgres:postgres@db:5432/subscription_db

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Webhook configuration
WEBHOOK_SECRET=test_webhook_secret_key_12345
